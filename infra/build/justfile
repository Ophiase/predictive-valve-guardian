set positional-arguments := true

root := source_directory() / "../.."
bake := "docker buildx bake --file infra/build/variables.hcl --file infra/build/contexts.hcl --file infra/build/build.hcl"

[doc("Build images at the dev tag: just image::build, or one target: just image::build api")]
build target="default":
    cd {{ root }} && {{ bake }} {{ target }}

[doc("Build every image tagged with VERSION and latest")]
[script("bash")]
release:
    set -euo pipefail
    cd {{ root }}
    VERSION=$(tr -d '[:space:]' < VERSION) {{ bake }} release

[doc("Print the resolved bake definition, nothing built")]
print target="default":
    cd {{ root }} && {{ bake }} --print {{ target }}

[doc("Build every image and push it to a registry at a tag: just image::push ghcr.io/me/ 1a2b3c4d")]
[script("bash")]
push registry tag:
    set -euo pipefail
    cd {{ root }}
    overrides=(--set "*.output=type=registry")
    for target in api web; do overrides+=(--set "$target.tags=$1valve-guardian-$target:$2"); done
    VERSION=$(tr -d '[:space:]' < VERSION) {{ bake }} "${overrides[@]}" default
